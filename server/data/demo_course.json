    {"id":"q02","knowledge_id":"integer","title":"整数乘法","prompt":"(-4) × (-6) 的结果是？","choices":["-24","-10","10","24"],"answer":"24","explanation":"负数乘负数为正数。","difficulty":0.35},
    {"id":"q03","knowledge_id":"fractions","title":"同分母分数","prompt":"3/8 + 2/8 的结果是？","choices":["5/16","5/8","1/8","6/8"],"answer":"5/8","explanation":"同分母分数相加，分母不变、分子相加。","difficulty":0.40},
    {"id":"q04","knowledge_id":"fractions","title":"异分母分数","prompt":"1/3 + 1/6 的结果是？","choices":["1/9","1/2","2/9","2/6"],"answer":"1/2","explanation":"通分为 2/6 + 1/6 = 3/6 = 1/2。","difficulty":0.62},
