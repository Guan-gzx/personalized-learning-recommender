    {"id":"q06","knowledge_id":"equations","title":"含括号方程","prompt":"解方程 2(x - 3) = 10，x = ?","choices":["2","5","8","13"],"answer":"8","explanation":"两边先除以 2，再加 3。","difficulty":0.68},
